# Copy to .env and fill in. Never commit the real .env file.

# Optional for Cursor Grok Bot (it can draft without this).
# Required for the Python path (python run.py uses xai_client).
# Get one at https://console.x.ai
XAI_API_KEY=

# Optional but recommended: raises GitHub API rate limits (60/hr -> 5000/hr)
GITHUB_TOKEN=

# Optional but recommended: raises Semantic Scholar rate limits
SEMANTIC_SCHOLAR_API_KEY=

# Optional, only needed once you swap CSV tracking for live Google Sheets
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEET_ID=

# Optional overrides (defaults shown)
XAI_REASONING_MODEL=grok-4
XAI_FAST_MODEL=grok-code-fast-1
DAILY_CAP=10
RELEVANCE_THRESHOLD=60
DISCOVER_MODE=industry
