# Copy to .env and fill in. Never commit the real .env file.

# Required: xAI (Grok) API key. Get one at https://console.x.ai
XAI_API_KEY=

# Optional but recommended: raises GitHub API rate limits (60/hr -> 5000/hr)
GITHUB_TOKEN=

# Optional: raises Semantic Scholar rate limits
SEMANTIC_SCHOLAR_API_KEY=

# Optional, only needed once you swap CSV tracking for live Google Sheets
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEET_ID=

# Optional overrides (defaults shown)
XAI_REASONING_MODEL=grok-4
XAI_FAST_MODEL=grok-code-fast-1
DAILY_CAP=10
RELEVANCE_THRESHOLD=60
